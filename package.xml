<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<package format="1" xmlns="https://wiki.freecad.org/Package_Metadata">
  <name>Code Workbench</name>
  <description>Work with build123d and CadQuery natively inside FreeCAD: scripts run in an isolated
    kernel and become real parametric document objects, with hot reload from any external editor.</description>
  <version>0.2.0</version>
  <date>2026-08-09</date>
  <maintainer email="freecad@jobi.is">jobi</maintainer>
  <license file="LICENSE">LGPL-2.1-or-later</license>
  <url type="repository" branch="main">https://github.com/3urdparty/freecad-code-workbench</url>
  <url type="readme">https://github.com/3urdparty/freecad-code-workbench/blob/main/README.md</url>
  <url type="bugtracker">https://github.com/3urdparty/freecad-code-workbench/issues</url>

  <content>
    <workbench>
      <classname>CodeWorkbench</classname>
      <subdirectory>./</subdirectory>
      <icon>freecad/code/resources/icons/code_workbench.svg</icon>
      <freecadmin>1.0</freecadmin>
      <pythonmin>3.10</pythonmin>
    </workbench>
  </content>
</package>
